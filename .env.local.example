# Vysiongids — APART Supabase-project (niet Vysion Order / kassa).
# Kopieer naar .env.local (lokaal) en zet dezelfde keys in Vercel → Project → Settings → Environment Variables.

# Publiek (browser mag anon key)
NEXT_PUBLIC_VYSIONGIDS_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_VYSIONGIDS_SUPABASE_ANON_KEY=eyJ...

# Alleen server (API routes: register, login, uploads) — NOOIT in client bundlen
VYSIONGIDS_SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Sessie na zaaknaam+pin (optioneel; genereer: openssl rand -base64 32). Ontbreekt lokaal?
# Dan wordt de secret afgeleid van VYSIONGIDS_SUPABASE_SERVICE_ROLE_KEY (zelfde als productie-fallback).
VYSIONGIDS_SESSION_SECRET=

# Beheer-sessie: opnieuw inloggen na X minuten zonder activiteit (standaard 5)
GIDS_SESSION_IDLE_MINUTES=5

# Interne medewerkerspagina
VYSIONGIDS_STAFF_PASSWORD=

# Stripe — premium horeca €49/jaar (zoekertjes + vacatures; Checkout + webhook)
STRIPE_SECRET_KEY=
STRIPE_GIDS_PREMIUM_WEBHOOK_SECRET=
# Optioneel: afwijkend bedrag in cent (default 4900 = €49)
# STRIPE_GIDS_PREMIUM_AMOUNT_CENTS=4900
# STRIPE_GIDS_DIENSTEN_AMOUNT_CENTS=9900
# Test zonder betaling (diensten aanmelden): alleen tijdelijk, niet op echte productie laten staan
# GIDS_DIENSTEN_SKIP_PAYMENT=1
# NEXT_PUBLIC_GIDS_DIENSTEN_SKIP_PAYMENT=1

NEXT_PUBLIC_VYSIONGIDS_SITE_URL=https://www.vysiongids.be

# Zoho SMTP — claim-notificaties naar info@vysionhoreca.com (zelfde als Vysion Horeca)
ZOHO_EMAIL=info@vysionhoreca.com
ZOHO_PASSWORD=
